DATABASE_URL=postgresql+psycopg://voice:voice_dev@localhost:5432/voice_platform
REDIS_URL=redis://localhost:6379/0

# Redis 队列键名（三个 Worker 独立队列，互不干扰）
# INFER_QUEUE_KEY=jobs:infer
# TRAIN_QUEUE_KEY=jobs:train
# BATCH_QUEUE_KEY=jobs:batch

# GPU 互斥锁（Train/Infer/Batch 在非 Mock 模式下不会同时占用 GPU）
# GPU_LOCK_KEY=gpu:lock
# GPU_LOCK_TTL_SEC=3600
STORAGE_ROOT=./data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8001/files
ENGINE_TTS_URL=http://127.0.0.1:9880
ENGINE_MOCK=true
# Real synthesis: set ENGINE_MOCK=false and point ENGINE_TRAIN_ROOT at local GPT-SoVITS clone
# ENGINE_TRAIN_ROOT=C:/Users/you/Desktop/GPT-SOVITS/GPT-SoVITS
# ENGINE_TRAIN_ROOT_IN_DOCKER=/workspace/GPT-SoVITS
DEV_SKIP_AUTH=true
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_ADMIN_USER_ID=bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb
# CATALOG_AUTO_APPROVE=true
# CATALOG_DEMO_TEXT=方源，你给我出来！
JWT_SECRET=dev-change-me-in-production-32bytes-min!!
JWT_EXPIRE_DAYS=7
SMS_MOCK=true
QUOTA_MONTHLY_CHAR_LIMIT=20000
QUOTA_MONTHLY_TRAIN_LIMIT=1

# 训练：默认 Mock（本机不跑 GPU 微调）。真实微调在云端 GPU，见 docs/architecture/2026-06-10-云端GPU训练指南.md
TRAIN_MOCK=true

# 以下仅当将来启用平台 Train Worker 本机微调时需要（当前不推荐 Windows 本地训练）
# ENGINE_TRAIN_ROOT=
# ENGINE_TRAIN_DOCKER=
# ENGINE_TRAIN_ROOT_IN_DOCKER=/workspace/GPT-SoVITS
# ENGINE_TRAIN_PLATFORM_MOUNT=/workspace/GPT
# TRAIN_USE_ASR=true
# TRAIN_ASR_LANGUAGE=zh

# W2 Module C — upload + QC (dev defaults)
CONSENT_AUTO_APPROVE=true
QC_DEV_RELAX_DURATION=true
QC_DEV_MIN_DURATION_SEC=3

# W3 Compliance — sensitive words + export label
# COMPLIANCE_WORDLIST_PATH=infra/compliance/sensitive_words.txt
COMPLIANCE_LABEL_TYPE=rhythm
COMPLIANCE_EXPORT_REQUIRED=true

# W4 Hardening — trace / alerts / release
# LOG_JSON=true

# Prometheus 指标端口（API 默认 9090，Worker 9091/9092/9093）
# METRICS_PORT=9090
# QUALITY_SIMILARITY_THRESHOLD=0.90
# QUALITY_MOCK=true
# QUALITY_EVAL_SENTENCE=你好，这是一次音色相似度测评试听。
# QUALITY_EVAL_SENTENCE_COUNT=1
# ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# ALERT_ON_JOB_FAILURE=true
# ALERT_WEBHOOK_FORMAT=feishu

# PAYMENT_PROVIDER=mock
# PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret-change-me
# SETTLEMENT_PLATFORM_FEE_BPS=1500
# SETTLEMENT_MIN_PAYOUT_CENTS=10000
# KYC_REQUIRED=true
# KYC_MOCK=true
WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 功能开关：设为 0 可隐藏运营台、支付订单、卖家钱包等实验功能
# VITE_LABS=0

# AI 智能剧本分段（DeepSeek，OpenAI 兼容 API）
# SCRIPT_PARSE_LLM_ENABLED=true
# DEEPSEEK_API_KEY=sk-your-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# SCRIPT_PARSE_LLM_MOCK=true
# SCRIPT_PARSE_MAX_CHARS=12000
