DATABASE_URL=postgresql+psycopg://voice:voice_dev@localhost:5432/voice_platform
REDIS_URL=redis://localhost:6379/0

# Redis 队列键名（三个 Worker 独立队列，互不干扰）
# INFER_QUEUE_KEY=jobs:infer
# TRAIN_QUEUE_KEY=jobs:train
# BATCH_QUEUE_KEY=jobs:batch

# GPU 互斥锁（Train/Infer/Batch 在非 Mock 模式下不会同时占用 GPU）
# GPU_LOCK_KEY=gpu:lock
# GPU_LOCK_TTL_SEC=3600
STORAGE_ROOT=./data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8001/files
ENGINE_TTS_URL=http://127.0.0.1:9880
ENGINE_MOCK=true
# Real synthesis: set ENGINE_MOCK=false and point ENGINE_TRAIN_ROOT at local GPT-SoVITS clone
# ENGINE_TRAIN_ROOT=C:/Users/you/Desktop/GPT-SOVITS/GPT-SoVITS
# ENGINE_TRAIN_ROOT_IN_DOCKER=/workspace/GPT-SoVITS
DEV_SKIP_AUTH=true
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_ADMIN_USER_ID=bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb
# CATALOG_AUTO_APPROVE=true
# CATALOG_DEMO_TEXT=方源，你给我出来！
# MARKETPLACE_INVITE_REQUIRED=true
# MARKETPLACE_QUALITY_GATE=true
# WEB_PUBLIC_BASE_URL=http://127.0.0.1:5173
JWT_SECRET=dev-change-me-in-production-32bytes-min!!
JWT_EXPIRE_DAYS=7
SMS_MOCK=true
# SMS_MOCK=true 时：未配置 Resend 则邮箱验证码在接口返回 mock_code（开发用）
# 邮箱登录（Resend）：配置后真实发信，与 SMS_MOCK 无关
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Phonia <onboarding@resend.dev>
# 自有域名验证后改为：Phonia <noreply@yourdomain.com>
# RESEND_API_BASE=https://api.resend.com
QUOTA_MONTHLY_CHAR_LIMIT=20000
QUOTA_MONTHLY_TRAIN_LIMIT=1

# 训练：默认 Mock（本机不跑 GPU 微调）。真实微调在云端 GPU，见 docs/architecture/2026-06-10-云端GPU训练指南.md
TRAIN_MOCK=true
# TRAIN_MODE=auto
# auto: TRAIN_MOCK=true→mock；TRAIN_MOCK=false 且无 ENGINE_TRAIN_ROOT→quick（快速克隆+真实引擎合成）
# quick: 用上传干声作参考，api_v2 zero-shot（需 ENGINE_MOCK=false + 9880）
# engine: 完整 GPU 微调（需 ENGINE_TRAIN_ROOT + Docker）
# cloud: 远端 GPU 一键微调（Studio 填写 SSH 或管理员配置 CLOUD_TRAIN_*，见 docs/architecture/2026-06-22-云端训练一键编排-MVP.md）

# 云端训练（AutoDL 等）：平台 SCP 上传干声 → 远端 train.sh → 拉回权重到 ENGINE_TRAIN_ROOT
# Studio 自服务：用户在 /studio 保存 SSH 即可，无需下方全局配置
# CLOUD_TRAIN_ENABLED=false
# CLOUD_TRAIN_SSH_HOST=
# CLOUD_TRAIN_SSH_PORT=22
# CLOUD_TRAIN_SSH_USER=root
# CLOUD_TRAIN_SSH_KEY_PATH=
# CLOUD_TRAIN_REMOTE_ENGINE_ROOT=/root/autodl-tmp/GPT-SoVITS
# CLOUD_TRAIN_REMOTE_PLATFORM_ROOT=/root/autodl-tmp/GPT
# CLOUD_TRAIN_REMOTE_WORK_DIR=/root/autodl-tmp/cloud_train_jobs
# CLOUD_TRAIN_SSH_TIMEOUT_SEC=7200
# CLOUD_TRAIN_LOCAL_DATASET_PREP=true

# 快速克隆每次合成前重置为 v2Pro 底模（避免 api_v2 进程内残留上一音色权重）
# 留空则从 ENGINE_TRAIN_ROOT/GPT_SoVITS/configs/tts_infer_v2pro.yaml 的 v2Pro 段读取
# ENGINE_DEFAULT_GPT_WEIGHTS=GPT_SoVITS/pretrained_models/s1v3.ckpt
# ENGINE_DEFAULT_SOVITS_WEIGHTS=GPT_SoVITS/pretrained_models/v2Pro/s2Gv2Pro.pth

# 以下仅当将来启用平台 Train Worker 本机微调时需要（当前不推荐 Windows 本地训练）
# ENGINE_TRAIN_ROOT=
# ENGINE_TRAIN_DOCKER=
# ENGINE_TRAIN_ROOT_IN_DOCKER=/workspace/GPT-SoVITS
# ENGINE_TRAIN_PLATFORM_MOUNT=/workspace/GPT
# TRAIN_USE_ASR=true
# TRAIN_ASR_LANGUAGE=zh
# TRAIN_DATASET_LLM_ENRICH=true

# W2 Module C — upload + QC (dev defaults)
CONSENT_AUTO_APPROVE=true
QC_DEV_RELAX_DURATION=true
QC_DEV_MIN_DURATION_SEC=3
QC_MAX_DURATION_SEC=3600

# 上传素材自动识别参考文本（faster-whisper，取音频前 9 秒）
ASR_ENABLED=true
# 开发占位识别（不装 whisper 时用 true）；真实听写用 false，platform_start 会自动 pip install [asr]
ASR_MOCK=false
# ASR_MODEL=base
# ASR_CLIP_SEC=9
# ASR_LANGUAGE=zh

# 训练素材自动增强（上传转 wav 后：高通/压缩/响度归一，利于云端微调）
# ASSET_ENHANCE_ENABLED=true
# ASSET_ENHANCE_PROFILE=clarity
# ASSET_ENHANCE_PROFILE=clarity_denoise
# ASSET_ENHANCE_TARGET_LUFS=-18
# ASSET_ENHANCE_SAMPLE_RATE=32000

# 本地 Studio 自训练（无需完整 GPU 微调时推荐 quick）
# TRAIN_MODE=quick
# KYC_REQUIRED=false

# W3 Compliance — sensitive words + export label
# COMPLIANCE_WORDLIST_PATH=infra/compliance/sensitive_words.txt
COMPLIANCE_LABEL_TYPE=rhythm
COMPLIANCE_EXPORT_REQUIRED=true

# W4 Hardening — trace / alerts / release
# LOG_JSON=true

# Prometheus 指标端口（API 默认 9090，Worker 9091/9092/9093）
# METRICS_PORT=9090
# QUALITY_SIMILARITY_THRESHOLD=0.90
# QUALITY_MOCK=true
# QUALITY_EVAL_SENTENCE=你好，这是一次音色相似度测评试听。
# QUALITY_EVAL_SENTENCE_COUNT=1
# ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# ALERT_ON_JOB_FAILURE=true
# ALERT_WEBHOOK_FORMAT=feishu

# PAYMENT_PROVIDER=mock
# PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret-change-me
# PAYMENT_NOTIFY_BASE_URL=https://api.yourdomain.com
# PAYMENT_CHECKOUT_ASYNC=false
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_SERIAL=
# WECHAT_PAY_PRIVATE_KEY=
# WECHAT_PAY_PRIVATE_KEY_PATH=
# WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PRIVATE_KEY_PATH=
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 沙箱网关：
# ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 沙箱联调文档：docs/architecture/2026-06-22-alipay-sandbox-沙箱联调.md
# SETTLEMENT_PLATFORM_FEE_BPS=1500
# SETTLEMENT_MIN_PAYOUT_CENTS=10000
# KYC_REQUIRED=true
# KYC_MOCK=true
# KYC_PROVIDER=auto
# KYC_SAAS_SUBMIT_URL=https://kyc-vendor.example.com/v1/verify
# KYC_SAAS_API_KEY=
# KYC_SAAS_WEBHOOK_SECRET=
# FINGERPRINT_AUTO_ENROLL=true
WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 功能开关：设为 0 可隐藏运营台、支付订单、卖家钱包等实验功能
# VITE_LABS=0

# AI 智能剧本分段（DeepSeek，OpenAI 兼容 API）
# SCRIPT_PARSE_LLM_ENABLED=true
# DEEPSEEK_API_KEY=sk-your-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# SCRIPT_PARSE_LLM_MOCK=true
# SCRIPT_PARSE_MAX_CHARS=12000

# 音色馆封面 AI 生成（通义万相 / DashScope）
# CATALOG_COVER_GEN_ENABLED=true
# 同时用于音色封面与创作者头像（通义万相）
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# 若从控制台复制为 apiKey,sk-xxx 格式，程序会自动去掉 apiKey, 前缀
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# DASHSCOPE_WANX_MODEL=wan2.2-t2i-flash
# DASHSCOPE_WANX_SIZE=1024*1024
