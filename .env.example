DATABASE_URL=postgresql+psycopg://voice:voice_dev@localhost:5432/voice_platform
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=./data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8001/files
ENGINE_TTS_URL=http://127.0.0.1:9880
ENGINE_MOCK=true
# Real synthesis: set ENGINE_MOCK=false and point ENGINE_TRAIN_ROOT at local GPT-SoVITS clone
# ENGINE_TRAIN_ROOT=C:/Users/you/Desktop/GPT-SOVITS/GPT-SoVITS
# ENGINE_TRAIN_ROOT_IN_DOCKER=/workspace/GPT-SoVITS
DEV_SKIP_AUTH=true
DEV_USER_ID=00000000-0000-0000-0000-000000000001
JWT_SECRET=dev-change-me-in-production-32bytes-min!!
JWT_EXPIRE_DAYS=7
SMS_MOCK=true
QUOTA_MONTHLY_CHAR_LIMIT=20000
QUOTA_MONTHLY_TRAIN_LIMIT=1

# 训练：默认 Mock（本机不跑 GPU 微调）。真实微调在云端 GPU，见 docs/architecture/2026-06-10-云端GPU训练指南.md
TRAIN_MOCK=true

# 以下仅当将来启用平台 Train Worker 本机微调时需要（当前不推荐 Windows 本地训练）
# ENGINE_TRAIN_ROOT=
# ENGINE_TRAIN_DOCKER=
# ENGINE_TRAIN_ROOT_IN_DOCKER=/workspace/GPT-SoVITS
# ENGINE_TRAIN_PLATFORM_MOUNT=/workspace/GPT
# TRAIN_USE_ASR=true
# TRAIN_ASR_LANGUAGE=zh

# W2 Module C — upload + QC (dev defaults)
CONSENT_AUTO_APPROVE=true
QC_DEV_RELAX_DURATION=true
QC_DEV_MIN_DURATION_SEC=3

# W3 Compliance — sensitive words + export label
# COMPLIANCE_WORDLIST_PATH=infra/compliance/sensitive_words.txt
COMPLIANCE_LABEL_TYPE=rhythm
COMPLIANCE_EXPORT_REQUIRED=true

# Web dev (Vite on :5173)
WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
