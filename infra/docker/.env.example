# Platform local dev — copy to .env
POSTGRES_USER=voice
POSTGRES_PASSWORD=voice_dev
POSTGRES_DB=voice_platform
POSTGRES_PORT=5432
REDIS_PORT=6379

# W1 API / Worker (also set in repo root .env for local uvicorn)
DATABASE_URL=postgresql+psycopg://voice:voice_dev@localhost:5432/voice_platform
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=./data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/files
ENGINE_TTS_URL=http://127.0.0.1:9880
ENGINE_MOCK=true
DEV_SKIP_AUTH=true
DEV_USER_ID=00000000-0000-0000-0000-000000000001
JWT_SECRET=dev-change-me-in-production
JWT_EXPIRE_DAYS=7
SMS_MOCK=true
